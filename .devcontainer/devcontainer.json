{
  "name": "CricPulse Backend",
  "image": "mcr.microsoft.com/devcontainers/java:25-bookworm",
  "remoteUser": "vscode",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  "forwardPorts": [8080, 5432],
  "portsAttributes": {
    "8080": {
      "label": "CricPulse Spring Boot API",
      "onAutoForward": "openBrowser"
    },
    "5432": {
      "label": "CricPulse PostgreSQL",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "vscjava.vscode-java-pack",
        "vmware.vscode-spring-boot"
      ]
    }
  },
  "postCreateCommand": "java -version && mvn -version && docker compose up -d postgres",
  "postStartCommand": "docker compose up -d postgres"
}
